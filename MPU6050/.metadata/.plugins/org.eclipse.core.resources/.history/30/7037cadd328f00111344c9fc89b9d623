#include "mpu6050.h"

/*step 1: To Check is Device ready to transfer*/

HAL_StatusTypeDef MPU6050_IsReady(I2C_HandleTypeDef *hi2c)
{
    return HAL_I2C_IsDeviceReady(hi2c, MPU6050_ADDR, 3, HAL_MAX_DELAY);
}

/*step 2: To Check whether the connected device is really an MPU6050*/

HAL_StatusTypeDef MPU6050_ReadWhoAmI(I2C_HandleTypeDef *hi2c, uint8_t *id)
{
    return HAL_I2C_Mem_Read(hi2c, MPU6050_ADDR, MPU6050_WHO_AM_I, I2C_MEMADD_SIZE_8BIT, id, 1, HAL_MAX_DELAY);
}

/*Step 3: To Initializes the MPU6050 sensor by waking it up */


HAL_StatusTypeDef MPU6050_Init(I2C_HandleTypeDef *hi2c)
{

	//0x00 wakes up the sensor and selects the internal 8MHz oscillator
	uint8_t data = 0x00;

    HAL_StatusTypeDef status;

    //Write 0x00 to Power Management 1 register to clear the SLEEP bit

    status = HAL_I2C_Mem_Write(hi2c, MPU6050_ADDR, MPU6050_PWR_MGMT_1, I2C_MEMADD_SIZE_8BIT, &data, 1, HAL_MAX_DELAY);

    //Wait for the sensor hardware oscillator to stabilize after waking up

    HAL_Delay(100);

    return status;
}


HAL_StatusTypeDef MPU6050_ReadAccel(I2C_HandleTypeDef *hi2c, MPU6050_t *mpu)
{
    uint8_t buffer[6];

    HAL_StatusTypeDef status;

    //Read 6 consecutive registers starting from ACCEL_XOUT_H

    status = HAL_I2C_Mem_Read(hi2c, MPU6050_ADDR, MPU6050_ACCEL_XOUT_H, I2C_MEMADD_SIZE_8BIT, buffer, 6, HAL_MAX_DELAY);

    // Abort if I2C communication fails

    if(status != HAL_OK)
        return status;

    // Reconstruct 16-bit signed values by combining High and Low bytes
    // (buffer[High] << 8) shifts the upper byte, then '|' merges the lower byte

    mpu->x = (int16_t)((buffer[0] << 8) | buffer[1]);
    mpu->y = (int16_t)((buffer[2] << 8) | buffer[3]);
    mpu->z = (int16_t)((buffer[4] << 8) | buffer[5]);

    return HAL_OK;
}
